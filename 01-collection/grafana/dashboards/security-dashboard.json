    {
      "id": 9,
      "title": "웹 방문자 세계지도 (GeoIP)",
      "type": "geomap",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "view": {
          "id": "zero",
          "lat": 0,
          "lon": 0,
          "zoom": 1
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "layers": [
          {
            "type": "markers",
            "name": "Visitor IPs",
            "config": {
              "style": {
                "size": {
                  "fixed": 8
                },
                "color": {
                  "fixed": "red"
                },
                "opacity": 0.8
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "tooltip": true
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"nginx_visitors_geo\"} |= \"client_type=\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "kvp",
            "replace": true
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "lat",
                "destinationType": "number"
              },
              {
                "targetField": "lon",
                "destinationType": "number"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 24,
      "title": "웹 방문 IP 목록 (24h)",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "request_count"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"nginx_visitors_geo\"} |= \"client_type=\"",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "kvp",
            "replace": true
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "request_count",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "tsNs": true,
              "labels": true,
              "id": true
            },
            "indexByName": {
              "src_ip": 0,
              "request_count": 1,
              "country": 2,
              "city": 3,
              "client_type": 4,
              "ua_family": 5,
              "user_agent": 6
            },
            "renameByName": {
              "src_ip": "IP",
              "request_count": "요청 수",
              "country": "국가",
              "city": "도시",
              "client_type": "유형",
              "ua_family": "UA Family",
              "user_agent": "User-Agent"
            }
          }
        }
      ]
    },
    {
