        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "tsNs": true,
              "labels": true,
              "id": true
            },
            "indexByName": {
              "Time": 0,
              "src_ip": 1,
              "request_path": 2,
              "status_code": 3,
              "ua_family": 4,
