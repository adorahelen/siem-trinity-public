{
  "title": "kangminlog 보안 대시보드",
  "uid": "security-main",
  "timezone": "Asia/Seoul",
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "SSH Invalid user 추이 (24h)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(count_over_time({job=\"auth\"} |= \"Invalid user\" [5m]))",
          "legendFormat": "Invalid user"
        }
      ]
    },
    {
      "id": 2,
      "title": "fail2ban Ban/Unban 이벤트 (24h)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(count_over_time({job=\"fail2ban\"} |= \"Ban\" [5m]))",
          "legendFormat": "Ban"
        },
        {
          "datasource": "Loki",
          "expr": "sum(count_over_time({job=\"fail2ban\"} |= \"Unban\" [5m]))",
          "legendFormat": "Unban"
        }
      ]
    },
    {
      "id": 3,
      "title": "KR-BLOCK 차단 이벤트 (24h)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(count_over_time({job=\"kern\", kern_event=\"[KR-BLOCK]\"}[5m]))",
          "legendFormat": "KR-BLOCK"
        }
      ]
    },
    {
      "id": 4,
      "title": "Nginx 상태코드 분포 (24h)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"nginx_recent_access\"} |~ \"\\\" 2[0-9]{2} \" [5m]))",
          "legendFormat": "2xx"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"nginx_recent_access\"} |~ \"\\\" 4[0-9]{2} \" [5m]))",
          "legendFormat": "4xx"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"nginx_recent_access\"} |~ \"\\\" 5[0-9]{2} \" [5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 25,
      "title": "웹 방문 유형 분포 (24h)",
      "type": "piechart",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "displayLabels": [
          "name",
          "percent",
          "value"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "pieType": "donut"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (client_type) (count_over_time({job=\"nginx_access_enriched\"} | logfmt [24h]))",
          "legendFormat": "{{client_type}}",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 27,
      "title": "ModSecurity 이벤트 추이 (24h)",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
