# SIEM-Trinity 환경 변수 예시
# 사용: cp .env.example .env  후 값 채우기
# docker compose는 같은 디렉터리의 .env를 자동 로드

# ─────────────────────────────────────────────────
# 01-collection · 02-detection — 호스트 바인딩 IP
# ─────────────────────────────────────────────────
# 어떤 인터페이스에서 외부 노출할지.
# - 운영 서버 (Tailscale 내부망 전용): HOST_BIND_IP=100.x.x.x
# - 테스트 VM (LAN 노출): HOST_BIND_IP=192.168.10.232
# - 로컬 개발 (localhost만): HOST_BIND_IP=127.0.0.1 (기본값)
HOST_BIND_IP=127.0.0.1

# ─────────────────────────────────────────────────
# 01-collection — Grafana admin 계정
# ─────────────────────────────────────────────────
# Public 공개 시 강한 비번 필수 (이슈 #13 참조)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=  # 필수 — openssl rand -base64 32 로 생성해 채울 것

# ─────────────────────────────────────────────────
# 02-detection — Loki 네트워크 참조
# ─────────────────────────────────────────────────
# 01-collection이 만드는 docker network 이름.
# 01-collection/docker-compose.yml의 `name: siem-trinity` 와 일치해야 함.
# 다른 환경에서 customize 가능:
#   - 운영 서버 (기존 폴더명 유지 시): security-log-monitor_default
#   - 새 환경 (이 PR 이후): siem-trinity_default (기본값)
LOKI_NETWORK_NAME=siem-trinity_default

# ─────────────────────────────────────────────────
# XDR 단계 4 — MISP (profile 활성화 시 필수)
# ─────────────────────────────────────────────────
# 활성화: docker compose --profile misp up -d
# 첫 부팅 시 admin 비밀번호 즉시 변경 권장 (Issue #13)
MISP_BASE_URL=https://localhost:8443
MISP_ADMIN_EMAIL=admin@admin.test
MISP_ADMIN_PASSWORD=  # 필수 — openssl rand -base64 32 로 생성해 채울 것
MISP_ADMIN_KEY=                   # 부팅 후 web UI 의 admin → My Profile 에서 발급한 API 키
MISP_ADMIN_ORG=SIEM-Trinity
MISP_DB_PASSWORD=  # 필수 — openssl rand -base64 32 로 생성해 채울 것
MISP_DB_ROOT_PASSWORD=  # 필수 — openssl rand -base64 32 로 생성해 채울 것

# 02-detection 의 MISP 연동 (활성화는 단계 4 검증 후)
MISP_ENABLED=false
MISP_URL=http://misp-core:80         # 컨테이너 내부 (HTTP, IPv4)
MISP_VERIFY_SSL=true

# ─────────────────────────────────────────────────
# XDR 단계 5 — Shuffle SOAR (profile 활성화 시 사용)
# ─────────────────────────────────────────────────
# 활성화: docker compose --profile shuffle up -d
# 첫 부팅 후 https://<HOST>:3001 에서 admin 계정 생성 → 워크플로우 작성
SHUFFLE_OPENSEARCH_PASSWORD=  # 필수 — openssl rand -base64 32 로 생성해 채울 것
SHUFFLE_OPENSEARCH_HEAP=1g

# 02-detection 의 Shuffle webhook 트리거 (활성화는 admin 이 workflow 생성 후)
SHUFFLE_ENABLED=false
SHUFFLE_WEBHOOK_URL=                  # Shuffle UI Webhook 트리거에서 발급한 URL

# ─────────────────────────────────────────────────
# XDR 단계 6 — TheHive 케이스 관리 (profile 활성화 시 사용)
# ─────────────────────────────────────────────────
# 활성화: docker compose --profile thehive up -d
# 첫 부팅 ~3-5분 (Cassandra schema init + ES green 대기)
# TheHive 5 는 Elasticsearch 7.17 호환 (8.x 절대 안 됨)
THEHIVE_SECRET=  # 필수 — openssl rand -base64 32 로 생성해 채울 것
THEHIVE_CASSANDRA_HEAP=1G
THEHIVE_ES_HEAP=1g
THEHIVE_HEAP=1g

# 02-detection 의 TheHive 케이스 자동 생성 (admin 가 API key 발급 후 활성화)
THEHIVE_ENABLED=false
THEHIVE_URL=http://thehive-app:9000
THEHIVE_API_KEY=
THEHIVE_AUTO_CASE_VERDICTS=Critical    # Critical 만 자동 케이스 (Danger/High 는 alert 만)

# detection-api React UI 의 TheHive 케이스 링크 base URL (운영자 브라우저에서 접근 가능한 외부 URL).
# THEHIVE_URL 은 docker network 내부 (http://thehive-app:9000) 라 브라우저에서 접근 불가 — 외부 URL 별도 지정.
# 예: THEHIVE_PUBLIC_URL=http://192.168.10.232:9000 또는 http://localhost:9000
THEHIVE_PUBLIC_URL=

# 합성 데이터 리플레이어 (profile "replay") — 빈 VM 의 Grafana 데이터 채우기
REPLAY_BASE_TPS=1.5
REPLAY_ANOMALY_INT=600
REPLAY_ANOMALY_DUR=120

# ─────────────────────────────────────────────────
# 02-detection · 보안 (CORS / 쓰기 액션 인증)
# ─────────────────────────────────────────────────
# CORS 허용 origin (콤마 구분). 미설정 시 localhost:5173 / 127.0.0.1:5173 만 허용.
# Tailscale / LAN 호스트 추가: http://192.168.10.232:5173,http://100.x.x.x:5173
CORS_ALLOWED_ORIGINS=

# /api/actions/* 쓰기 액션의 X-API-Key 헤더 값. 미설정 시 인증 비활성 (개발용).
# 운영 시 필수 설정. TrinitySOC UI 도 동일 키로 호출해야 동작.
ACTIONS_API_KEY=
