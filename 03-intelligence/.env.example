# ──────────────────────────────────────
# 서버 연결 (Tailscale VPN 또는 LAN)
# ──────────────────────────────────────
LOKI_URL=http://100.xx.xx.xx:3100    # 운영 서버 또는 테스트 VM의 Loki

# ──────────────────────────────────────
# Ollama (로컬 네이티브 설치 — Linux x86_64)
# ──────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-q4_K_M   # 고정 모델 (Google Gemma 4 E2B q4_K_M)
EMBED_MODEL=nomic-embed-text

# ──────────────────────────────────────
# 로컬 저장소 (Linux 경로)
# ──────────────────────────────────────
CHROMA_PATH=${HOME}/.xdr/chroma_db
REPORTS_PATH=${HOME}/SIEM-Trinity/03-intelligence/reports
